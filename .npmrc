
# npm settings
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# package scripts
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Only run lifecycle scripts if a package defines them (no-op otherwise)
if-present=true

# package dependencies
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Record installs in package.json automatically
save=true

# Pin exact versions — no ^ or ~ ranges
save-exact=true

# Security
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Fail install if the project's engines field isn't satisfied
engine-strict=true

# Install scripts run only for packages approved in package.json's
# `allowScripts` (npm 12): `npm install-scripts ls` lists what is waiting,
# `approve` / `deny` record the decision. ignore-scripts stays off because it
# would also skip the root `dependencies` script, whose `packager link` links
# the org providers' shared packages. "install scripts blocked" warnings for
# an org repository's `prepare` are expected (npm builds a `github:`
# dependency in its own temp clone); don't add allowScripts entries for them.

# npx
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Require packages to be installed before npx can run them
yes=false

# Project vs Global Configuration
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# This file in project root: affects only this project
# ~/.npmrc: affects all projects for your user
# /etc/npmrc: affects all users on the system

# Priority (highest to lowest):
# 1. Command-line flags
# 2. Project .npmrc
# 3. User ~/.npmrc
# 4. Global /etc/npmrc
# 5. npm defaults

# org repositories are `github:` dependencies, which npm 12 refuses by default
allow-git=all
