# 1. Ignore everything by default
*

# 2. Whitelist tracked files and folders
!/.claude/
!/.claude/**
!/.gitignore
!/.gitmodules
!/.npmrc
!/CLAUDE.md
!/readme.md
!/package.json
!/package-lock.json
!/src/
!/src/**

# 3. Blacklist nested exceptions inside whitelisted trees

# local-only Claude settings — must never be committed
.claude/settings.local.json

# An analyzed app's own output (cli.analyze-app.mjs, e.g.
# src/apps/roku-app/graphify-output/).
**/graphify-output/

# generated output: reference databases, raw bsbench captures, the db-graph
# build. The durable benchmark output lives in checked-in files like
# src/tools/lang-graph/src/parse/roku-benchmark/roku-benchmark.catalog.json
**/.artifacts/

# code-review-graph generated files
**/.code-review-graph/

# links this checkout's dependencies to sibling checkouts (packager)
**/package-local.json
